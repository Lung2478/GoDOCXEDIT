# ==============================================================================
# GoDOCXEDIT — Git Attributes
# Normalize text line endings and mark binary documents/assets cleanly.
# ==============================================================================

# Default text normalization (LF in repository)
* text=auto eol=lf

# Source code & documentation (LF)
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows shell scripts (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (prevent diff corruption & line-ending rewriting)
*.docx binary
*.odt binary
*.pdf binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.exe binary
