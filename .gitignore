# ==============================================================================
# GoDOCXEDIT Public Release & AI Interface Repository (/dist/.gitignore)
# ==============================================================================
# Compiled executables (.exe), live .docx manuals, and release checksum manifests
# are distributed via GitHub Releases (never committed into the public Git tree).

# --- GitHub Release Assets (stay in /dist for Release upload, never in Git) ---
*.exe
*.docx
SHA256SUMS.txt

# --- Temp, Cache, Environment & OS Metadata ---
*.tmp
*.log
*.bak
*.orig
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
*.key
*.pem
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
